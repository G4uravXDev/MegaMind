/* ZIT Global TCSS Stylesheet */

Screen {
    background: $background;
    color: $text;
}

Header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
}

Footer {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
}

#repo-status-bar {
    dock: top;
    height: 3;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $accent;
    layout: horizontal;
    align-vertical: middle;
}

.status-badge {
    margin-right: 2;
    text-style: bold;
}

.badge-branch {
    color: $warning;
}

.badge-clean {
    color: $success;
}

.badge-dirty {
    color: $error;
}

.badge-sync {
    color: $accent;
}

#dashboard-main {
    height: 1fr;
    layout: horizontal;
}

#dashboard-left {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#dashboard-right {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.panel-header {
    height: 1;
    text-style: bold;
    color: $accent;
    margin: 1 0 0 0;
}


#staging-main {
    height: 1fr;
    layout: horizontal;
}

#staging-left {
    width: 2fr;
    height: 100%;
    padding: 0 1;
}

#staging-right {
    width: 3fr;
    height: 100%;
    padding: 0 1;
}

#diff-header {
    height: 1;
    text-style: bold;
    color: $warning;
    margin: 1 0 0 0;
}

#commit-main {
    height: 1fr;
    layout: horizontal;
}

#commit-left {
    width: 2fr;
    height: 100%;
    padding: 0 1;
}

#commit-right {
    width: 3fr;
    height: 100%;
    padding: 0 1;
}

#commit-message-input {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

#commit-actions {
    height: 3;
    margin-top: 1;
    layout: horizontal;
    align-horizontal: right;
}

#commit-actions Button {
    margin-left: 2;
}

#branches-main {
    height: 1fr;
    padding: 0 1;
}

#branch-options {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

#log-main {
    height: 1fr;
    layout: horizontal;
}

#log-left {
    width: 3fr;
    height: 100%;
    padding: 0 1;
}

#log-right {
    width: 2fr;
    height: 100%;
    padding: 0 1;
}

#graph-options {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

#commit-detail-scroll {
    height: 1fr;
    border: solid $primary;
    background: $surface;
    padding: 1;
}

/* Time Travel screen */

#time-travel-main {
    height: 1fr;
    layout: horizontal;
}

#time-travel-left {
    width: 3fr;
    height: 100%;
    padding: 0 1;
}

#time-travel-right {
    width: 2fr;
    height: 100%;
    padding: 0 1;
}

#tt-options {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

#tt-detail-content {
    height: 1fr;
    border: solid $primary;
    background: $surface;
    padding: 1;
}

/* Conflict Resolution screen */

#conflict-main {
    height: 1fr;
    layout: horizontal;
}

#conflict-ours-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#conflict-center-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#conflict-theirs-panel {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.conflict-side-content {
    height: 1fr;
    border: solid $accent;
    background: $surface;
    padding: 1;
}

#conflict-resolution-input {
    height: 1fr;
    border: solid $primary;
    background: $surface;
}

#conflict-ai-explanation {
    height: auto;
    color: $warning;
    padding: 0 1;
    margin-top: 1;
}

#conflict-actions {
    height: 3;
    margin-top: 1;
    layout: horizontal;
    align-horizontal: right;
}

#conflict-actions Button {
    margin-left: 1;
}

/* AI Mentor Chat screen */

#mentor-main {
    height: 1fr;
    padding: 0 1;
}

#mentor-chat-scroll {
    height: 1fr;
    border: solid $accent;
    background: $surface;
    padding: 1;
}

#mentor-input-bar {
    height: 3;
    margin-top: 1;
    layout: horizontal;
}

#mentor-question-input {
    width: 1fr;
    border: solid $primary;
}

#btn-mentor-send {
    width: 12;
    margin-left: 1;
}

.chat-msg {
    margin-bottom: 1;
    padding: 1;
    width: 100%;
}

.chat-system {
    background: $panel;
    color: $accent;
    border-left: thick $accent;
}

.chat-user {
    background: $boost;
    color: $text;
    border-left: thick $primary;
}

.chat-ai {
    background: $surface;
    color: $text;
    border-left: thick $warning;
}

.chat-mentor-label {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

/* Help Modal Overlay */

#help-box {
    width: 80%;
    height: 80%;
    border: thick $primary;
    background: $panel;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    content-align: center middle;
    width: 100%;
}

#help-scroll {
    height: 1fr;
    border: solid $accent;
    background: $surface;
    padding: 1 2;
}

#help-buttons {
    height: 3;
    margin-top: 1;
    layout: horizontal;
    align-horizontal: center;
}

#help-buttons Button {
    width: 24;
}

/* Coverage Modal */

#coverage-box {
    width: 85%;
    height: 80%;
    border: thick $primary;
    background: $panel;
    padding: 1 2;
}

#coverage-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    width: 100%;
}

#coverage-code-view {
    height: 1fr;
    border: solid $accent;
    background: $surface;
}

#coverage-buttons {
    grid-size: 2;
    grid-gutter: 2;
    height: 3;
    margin-top: 1;
}

#coverage-buttons Button {
    width: 100%;
}
